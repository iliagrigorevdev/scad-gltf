{
  "name": "scad-gltf",
  "version": "0.3.2",
  "description": "WASM build of a custom OpenSCAD fork that compiles .scad scripts directly to glTF/GLB with PBR and animation support",
  "type": "module",
  "main": "./src/ext/openscad.js",
  "author": "Ilia Grigorev",
  "license": "GPL-2.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iliagrigorevdev/scad-gltf.git"
  },
  "bugs": {
    "url": "https://github.com/iliagrigorevdev/scad-gltf/issues"
  },
  "homepage": "https://iliagrigorevdev.github.io/scad-gltf/",
  "keywords": [
    "openscad",
    "gltf",
    "glb",
    "wasm",
    "3d",
    "cad",
    "godot",
    "mcp",
    "ai"
  ],
  "files": [
    "bin",
    "src",
    "godot",
    "editor/dist"
  ],
  "bin": {
    "scad-gltf": "./bin/scad-gltf.js"
  },
  "exports": {
    ".": "./src/ext/openscad.js",
    "./convert": "./src/convert.js",
    "./convert.js": "./src/convert.js",
    "./prompt": "./src/prompt.js",
    "./prompt.js": "./src/prompt.js",
    "./openscad.wasm": "./src/ext/openscad.wasm"
  },
  "scripts": {
    "format": "prettier --write .",
    "mcp": "npx @modelcontextprotocol/inspector node ./bin/mcp.js",
    "prepublishOnly": "npm install --prefix editor && npm run build --prefix editor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "clipboardy": "^5.3.2",
    "express": "^5.2.1",
    "puppeteer": "^25.9.0"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
